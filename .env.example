# ─── BSV / Wallet ────────────────────────────────────────────────────────────
# Private key for the certifier server wallet (hex-encoded)
SERVER_PRIVATE_KEY=
# BSV network: 'main' or 'test'
BSV_NETWORK=main
# Wallet storage URL for the BSV wallet toolbox
WALLET_STORAGE_URL=

# ─── Float treasury monitor (optional) ───────────────────────────────────────
# Bearer token Float presents to GET /treasury/balance (read-only balance).
# Provisioned per app and injected at deploy time; leave blank to keep the
# route disabled. Never commit a real value. Minimum 16 characters.
FLOAT_BALANCE_TOKEN=

# ─── Redis ───────────────────────────────────────────────────────────────────
# Password injected into Redis via --requirepass and REDIS_URL. Required in production.
REDIS_PASSWORD=change_me_in_production
# REDIS_URL is constructed from REDIS_PASSWORD in docker-compose — override only if using external Redis
# REDIS_URL=redis://:change_me@redis:6379

# ─── Twilio (Email + SMS verification) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# ─── X / Twitter (OAuth 2.0) ────────────────────────────────────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/verify/x/callback

# ─── Google (OAuth 2.0) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/verify/google/callback

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
HTTP_PORT=8080
HOSTING_DOMAIN=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ─── Mobile wallet relay (@bsv/wallet-relay) ────────────────────────────────
# QR pairing for BRC-100 mobile wallets when no local substrate is detected.
RELAY_ENABLED=true
# http(s):// URL of the BACKEND as reachable from the phone. Embedded in the QR
# as the pairing origin; the phone fetches the relay socket URL from it.
# Local dev: point an ngrok tunnel at the backend, e.g.
#   ngrok http 8080 --url deggen.ngrok.app
RELAY_PUBLIC_URL=http://localhost:8080
# ws(s):// URL of the relay socket (defaults to RELAY_PUBLIC_URL with ws scheme)
RELAY_WS_URL=ws://localhost:8080
# Deep-link scheme in the QR pairing URI — must match the mobile wallet app
QR_SCHEMA=bsv-wallet

# ─── Frontend (Vite build args) ──────────────────────────────────────────────
# These are baked into the frontend at Docker build time via build args.
# Override in .env for production domains.
VITE_FRONT_URL=http://localhost:3000
VITE_API_URL=http://localhost:8080/api
# Network reported to a QR-paired mobile wallet: mainnet | testnet
VITE_BSV_NETWORK=mainnet

# ─── Monitoring (optional) ──────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin
